{
  "name": "mnau-attendance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "dev:local": "next dev --port 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:check": "node --import tsx scripts/check-database.ts",
    "db:reset-demo": "node --import tsx scripts/reset-demo.ts",
    "demo:attendance": "node --import tsx scripts/generate-demo-attendance.ts",
    "schedule:generate": "node --import tsx scripts/generate-semester-schedule.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/verify.mjs",
    "test:database": "node scripts/test-database.mjs",
    "check:conflicts": "node --import tsx scripts/check-conflicts.ts",
    "verify:server": "node scripts/verify.mjs",
    "dev:next": "next dev --hostname 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "bcryptjs": "3.0.2",
    "dotenv": "17.2.3",
    "luxon": "3.7.2",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/luxon": "3.7.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mysql2": "3.24.3"
  }
}