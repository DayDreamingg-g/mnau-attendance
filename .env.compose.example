COMPOSE_PROJECT_NAME=mnau-attendance
WEB_PORT=3000
N8N_PORT=5678
PG_LOCAL_PORT=5432
POSTGRES_ADMIN_PASSWORD=REPLACE_RANDOM_ADMIN_PASSWORD
APP_DB_PASSWORD=REPLACE_RANDOM_APP_PASSWORD
N8N_DB_PASSWORD=REPLACE_RANDOM_N8N_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_RANDOM_ENCRYPTION_KEY
REPORT_MACHINE_TOKEN=REPLACE_RANDOM_MACHINE_TOKEN
APP_ORIGIN=http://localhost:3000
# Freeze time only with APP_ENV=demo, DEMO_MODE=true and DEMO_DATE.
# Empty DEMO_DATE keeps demo data with the real Europe/Kyiv clock.
# Production: APP_ENV=production, DEMO_MODE=false, empty DEMO_DATE, HTTPS.
APP_ENV=demo
DEMO_MODE=true
DEMO_DATE=
COOKIE_SECURE=false
