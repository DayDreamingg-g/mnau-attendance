generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  teacherProfile Teacher?
  studentProfile Student?
}

model Faculty {
  id   Int    @id @default(autoincrement())
  name String @unique

  specialties Specialty[]
}

model Specialty {
  id   Int    @id @default(autoincrement())
  code String?
  name String

  facultyId Int
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  groups Group[]

  @@unique([facultyId, name])
}

model Group {
  id     Int    @id @default(autoincrement())
  name   String
  course Int

  specialtyId Int
  specialty   Specialty @relation(fields: [specialtyId], references: [id])

  students Student[]
  lessons  Lesson[]

  @@unique([specialtyId, name])
}

model Student {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())

  groupId Int
  group   Group @relation(fields: [groupId], references: [id])

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  attendances Attendance[]
}

model Teacher {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  createdAt DateTime @default(now())

  userId Int @unique
  user   User @relation(fields: [userId], references: [id])

  lessons Lesson[]
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique

  lessons Lesson[]
}

model Building {
  id      Int    @id @default(autoincrement())
  code    String @unique
  name    String
  address String

  lessons Lesson[]
}

model Lesson {
  id           Int      @id @default(autoincrement())
  date         DateTime
  lessonNumber Int
  room         String

  groupId Int
  group   Group @relation(fields: [groupId], references: [id])

  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id])

  attendances Attendance[]

  @@unique([date, lessonNumber, groupId])
}

model AttendanceStatus {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  attendances Attendance[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  statusId Int
  status   AttendanceStatus @relation(fields: [statusId], references: [id])

  @@unique([studentId, lessonId])
}