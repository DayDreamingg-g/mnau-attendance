{
  "name": "Attendance attention below 70 percent",
  "nodes": [
    {
      "parameters": {},
      "id": "9dbbe203-716b-563c-8b22-ac14dda4c044",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        180
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 21 * * *"
            }
          ]
        }
      },
      "id": "5dd6fcbe-58b7-5800-9dd0-dfd31b8aa730",
      "name": "Scheduled run",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://web:3000/api/machine/reports",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"action\": \"ALERT70\", \"requireReady\": true}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "1193d690-3ecc-56e8-819b-7cc76be7fd67",
      "name": "Create and persist report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        280
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "MNAU report machine"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (result.state !== 'READY') {\n  throw new Error('MNAU automation did not reach READY: ' + String(result.state ?? 'missing state'));\n}\nreturn [{json: {...result, message: result.message ?? 'Report files and summary are persisted in MNAU Attendance.'}}];"
      },
      "id": "b86cb4b6-5937-526d-9521-04d816c116b4",
      "name": "Verify persisted result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        280
      ]
    }
  ],
  "connections": {
    "Manual run": {
      "main": [
        [
          {
            "node": "Create and persist report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scheduled run": {
      "main": [
        [
          {
            "node": "Create and persist report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create and persist report": {
      "main": [
        [
          {
            "node": "Verify persisted result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Kyiv",
    "saveDataErrorExecution": "all",
