{
  "name": "Weekly curator attendance summary",
  "nodes": [
    {
      "parameters": {},
      "id": "306b7770-2f49-5960-b85c-e6675140a781",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        180
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "21c373c9-3048-5876-a2e5-e485231bdbda",
      "name": "Scheduled run",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://web:3000/api/machine/reports",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"action\": \"WEEKLY_CURATORS\", \"requireReady\": true}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "308f134b-440c-5554-a58d-c24e85f00d44",
      "name": "Create and persist report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        280
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "MNAU report machine"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (result.state !== 'READY') {\n  throw new Error('MNAU automation did not reach READY: ' + String(result.state ?? 'missing state'));\n}\nreturn [{json: {...result, message: result.message ?? 'Report files and summary are persisted in MNAU Attendance.'}}];"
      },
      "id": "9ec38292-be74-5259-9495-2505bf9c3668",
      "name": "Verify persisted result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        280
      ]
    }
  ],
  "connections": {
    "Manual run": {
      "main": [
        [
          {
            "node": "Create and persist report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scheduled run": {
      "main": [
        [
          {
            "node": "Create and persist report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create and persist report": {
      "main": [
        [
          {
            "node": "Verify persisted result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Kyiv",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true,
    "executionTimeout": 600
  },
  "active": false,
  "pinData": {},
  "tags": []
}
